TZ=Europe/Warsaw

DOMAIN=home.arpa

# Reusable (not ephemeral) key: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
TS_HOSTNAME=homelab
TS_HOSTNAME_FQDN=homelab.tailXXXXX.ts.net
TS_ROUTES=172.28.10.0/24,192.168.1.0/24
TS_EXTRA_ARGS=

GRAFANA_ADMIN_PASSWORD=

AUTHENTIK_SECRET_KEY=
AUTHENTIK_DB_PASSWORD=

NEXTCLOUD_DB_ROOT_PASSWORD=
NEXTCLOUD_DB_PASSWORD=
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=

OPEN_WEBUI_SECRET_KEY=

GRAFANA_OIDC_ENABLED=false
GRAFANA_OIDC_CLIENT_ID=
GRAFANA_OIDC_CLIENT_SECRET=

OPEN_WEBUI_TRUSTED_EMAIL_HEADER=
OPEN_WEBUI_TRUSTED_NAME_HEADER=

# Optional, for authentik password resets.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=authentik@home.arpa

OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_CONTEXT_LENGTH=8192

PROM_RETENTION=30d

BACKUP_REPOSITORY=/mnt/backup/homelab
BACKUP_PASSWORD=

TAILSCALE_TAG=stable
NGINX_TAG=1.27-alpine
ADGUARD_TAG=latest
PROMETHEUS_TAG=latest
NODE_EXPORTER_TAG=latest
GRAFANA_TAG=latest
AUTHENTIK_TAG=latest
NEXTCLOUD_TAG=stable-apache
OLLAMA_TAG=latest
OPEN_WEBUI_TAG=main
POSTGRES_TAG=16-alpine
MARIADB_TAG=11
REDIS_TAG=7-alpine
