server {
    listen 80 default_server;
    server_name _;

    location / {
        return 301 https://$host$request_uri;
    }
}

# Anything not matching a known subdomain: close without responding.
server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    include /etc/nginx/snippets/tls.conf;

    return 444;
}
