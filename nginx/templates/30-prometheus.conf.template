# Prometheus has no authentication of its own - all access to it rests on
# authentik forward auth. Do not expose it without this.
server {
    listen 443 ssl;
    http2 on;
    server_name prometheus.${DOMAIN};

    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/authentik-location.conf;

    location / {
        include /etc/nginx/snippets/authentik-authrequest.conf;
        proxy_pass http://prometheus:9090;
        include /etc/nginx/snippets/proxy.conf;
    }
}
